APP_NAME="Velora Logistics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=velora_logistics
DB_USERNAME=postgres
DB_PASSWORD=

# Seeded Admin & General Demo Credentials
SEED_ADMIN_EMAIL=admin@veloralogistics.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_USER_PASSWORD=ChangeMeUser123!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="dispatch@veloralogistics.local"
MAIL_FROM_NAME="${APP_NAME}"
